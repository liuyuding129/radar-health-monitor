<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lz.radar.mapper.IotProtocolMapper">

    <!--  查询所有协议配置  -->
    <select id="selectAllProtocols" resultType="com.lz.radar.domain.IotProtocol">
        SELECT * FROM iot_protocol ORDER BY create_time DESC
    </select>

    <!--  根据协议ID查询协议配置  -->
    <select id="selectProtocolById" resultType="com.lz.radar.domain.IotProtocol"
            parameterType="java.lang.Long">
        SELECT * FROM iot_protocol WHERE protocol_id = #{protocolId}
    </select>

    <!--  根据协议名称查询协议配置  -->
    <select id="selectProtocolByName" resultType="com.lz.radar.domain.IotProtocol"
            parameterType="java.lang.String">
        SELECT * FROM iot_protocol WHERE protocol_name = #{protocolName}
    </select>

    <!--  根据协议名称查询协议配置 - MQTT  -->
    <select id="getProtocolsByMQTT" resultType="com.lz.radar.domain.IotProtocol">
        SELECT
            pro.*,
            dev.device_id
        FROM
            iot_protocol AS pro
                INNER JOIN iot_device AS dev ON pro.protocol_id = dev.protocol_id
        WHERE
            pro.remark LIKE '%MQTT%';
    </select>

    <!--  根据协议名称查询协议配置 - TCP -->
    <select id="getProtocolsByTCP" resultType="com.lz.radar.domain.IotProtocol">
        SELECT
            pro.*,
            dev.device_id
        FROM
            iot_protocol AS pro
                INNER JOIN iot_device AS dev ON pro.protocol_id = dev.relay_protocol_id
        WHERE
            pro.remark LIKE '%TCP%';
    </select>

    <!--  验证协议配置是否已存在  -->
    <select id="validateProtocolConfigIsNo" resultType="com.lz.radar.domain.IotProtocol"
            parameterType="java.lang.String">
        SELECT * FROM iot_protocol WHERE config_json = #{protocolConfig}
    </select>

    <!--  插入新协议配置  -->
    <insert id="insertProtocol" parameterType="com.lz.radar.domain.IotProtocol">
        INSERT INTO iot_protocol
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="protocolId != null">protocol_id,</if>
            <if test="protocolName != null">protocol_name,</if>
            <if test="description != null">description,</if>
            <if test="configJson != null">config_json,</if>
            <if test="remark != null">remark,</if>
            <if test="sendTopic != null">send_topic,</if>
            create_time
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="protocolId != null">#{protocolId},</if>
            <if test="protocolName != null">#{protocolName},</if>
            <if test="description != null">#{description},</if>
            <if test="configJson != null">#{configJson},</if>
            <if test="remark != null">#{remark},</if>
            <if test="sendTopic != null">#{sendTopic},</if>
            CURRENT_TIMESTAMP
        </trim>
    </insert>

    <!--  更新协议配置  -->
    <update id="updateProtocol" parameterType="com.lz.radar.domain.IotProtocol">
        UPDATE iot_protocol
        <set>
            <if test="protocolName != null">protocol_name = #{protocolName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="configJson != null">config_json = #{configJson},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="sendTopic != null">send_topic = #{sendTopic},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE protocol_id = #{protocolId}
    </update>

    <!--  根据协议ID删除协议配置  -->
    <delete id="deleteProtocolById" parameterType="java.lang.Long">
        DELETE FROM iot_protocol WHERE protocol_id = #{protocolId}
    </delete>

</mapper>